{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["notification_id", "system_id", "user_id", "channel", "status", "attempt"],
  "properties": {
    "notification_id": { "type": "string", "minLength": 1 },
    "system_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "enum": ["sms", "email", "telegram"] },
    "status": { "type": "string", "enum": ["pending", "sent", "failed", "skipped"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "provider_message_id": { "type": "string" },
    "error": { "type": "string" },
    "sent_at": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
