{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["notification_id", "system_id", "user_ids", "channels"],
  "properties": {
    "notification_id": { "type": "string", "minLength": 1 },
    "system_id": { "type": "string", "minLength": 1 },
    "user_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "channels": {
      "type": "array",
      "items": { "type": "string", "enum": ["sms", "email", "telegram"] },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
